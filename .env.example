# Copy to .env. Sample mode needs none of the keys below.
SAMPLE_MODE=true
DATA_BACKEND=duckdb

# NVIDIA build.nvidia.com (OpenAI-compatible). The only LLM provider.
NVIDIA_API_KEY=
NVIDIA_MAIN_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# When true (and NVIDIA_API_KEY is set), call Nemotron even in SAMPLE_MODE
# (synthetic data + live LLM). On error/timeout: recorded cache → offline_rules.
LLM_LIVE=false

# Role -> model tier. Allowed tiers: main, fast.
ROLE_MODELS={"router":"main","writer":"main","actions":"main","web_extract":"main","default":"main","critic":"fast","memory_extract":"fast"}

# When true, live NVIDIA responses are also written to data/cache for sample replay.
RECORD_LLM_CACHE=false

# Comma-separated roles that keep Nemotron thinking on (enable_thinking=true).
# Default empty: thinking is disabled for every role.
REASONING_ROLES=

TAVILY_API_KEY=

# Zetaris (direct REST). Defaults match a local Docker install.
# ZETARIS_URL is a deprecated alias for ZETARIS_REST_URL.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_SCHEMA=recall
# usl = lightning.metastore.recallai.recall.* (default when DATA_BACKEND=zetaris)
# tables = raw FILESTORE recall.handles / contacts / …
ZETARIS_READ_MODE=usl
ZETARIS_USL_NAMESPACE=lightning.metastore.recallai.recall
ZETARIS_API_KEY=
ZETARIS_USER=
ZETARIS_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RIVA_SERVER=
RIVA_API_KEY=
# NVIDIA Cloud Function id for Riva Parakeet ASR (grpc.nvcf.nvidia.com).
RIVA_ASR_FUNCTION_ID=

# Bearer token for /api/* and /ws/trace?token= (phone + dashboard).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECALL_API_TOKEN=

# Bounds. Non-LLM HTTP calls time out at 15s; LLM calls at 30s.
HTTP_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=30
MAX_CRITIC_ROUNDS=2
MAX_RETRIES=3

# Demo dataset (Jordan Lefebvre / Tidepool). Unit tests pin data/sample instead.
SAMPLE_DATA_DIR=data/synthetic/tables
# Optional frozen clock for sample mode (overrides dataset.json "now").
# SAMPLE_NOW=2026-10-26T18:00:00-04:00
LIVE_DATA_DIR=data/live
CACHE_DIR=data/cache
LOGS_DIR=logs

# Food/places preference profiles (on-demand). Set false to disable globally.
PREFERENCE_PROFILES=true

# Cloud VM: Postgres + Mac agent upload (POST /api/ingest/mac).
DATABASE_URL=
DEVICE_UPLOAD_TOKEN=

# Dashboard login (optional). The API token also works as a password.
RECALL_LOGIN_EMAIL=
RECALL_LOGIN_PASSWORD=
# Public https URL of this server — Google sign-in redirects to <this>/api/connect/google/callback
RECALL_PUBLIC_URL=
# Your own email(s), left out of meeting attendee lists (auto-detected if empty)
RECALL_OWNER_EMAILS=
# Recall's voice: NVIDIA Magpie TTS (uses NVIDIA_API_KEY). Browser voice is the fallback.
TTS_ENABLED=true
TTS_VOICE=Magpie-Multilingual.EN-US.Aria
