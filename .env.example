# Copy to .env. Sample mode needs none of the keys below.
SAMPLE_MODE=true
DATA_BACKEND=duckdb

# NVIDIA build.nvidia.com (OpenAI-compatible). The only LLM provider.
NVIDIA_API_KEY=
NVIDIA_MAIN_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Role -> model tier. Allowed tiers: main, fast.
ROLE_MODELS={"router":"main","writer":"main","actions":"main","web_extract":"main","default":"main","critic":"fast","memory_extract":"fast"}

# When true, live NVIDIA responses are also written to data/cache for sample replay.
RECORD_LLM_CACHE=false

# Comma-separated roles that keep Nemotron thinking on (enable_thinking=true).
# Default empty: thinking is disabled for every role.
REASONING_ROLES=

TAVILY_API_KEY=

# Zetaris (direct REST). Defaults match a local Docker install.
# ZETARIS_URL is a deprecated alias for ZETARIS_REST_URL.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_SCHEMA=recall
# usl = lightning.metastore.recallai.recall.* (default when DATA_BACKEND=zetaris)
# tables = raw FILESTORE recall.handles / contacts / …
ZETARIS_READ_MODE=usl
ZETARIS_USL_NAMESPACE=lightning.metastore.recallai.recall
ZETARIS_API_KEY=
ZETARIS_USER=
ZETARIS_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RIVA_SERVER=
RIVA_API_KEY=

# Bounds. Non-LLM HTTP calls time out at 15s; LLM calls at 30s.
HTTP_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=30
MAX_CRITIC_ROUNDS=2
MAX_RETRIES=3

SAMPLE_DATA_DIR=data/sample
LIVE_DATA_DIR=data/live
CACHE_DIR=data/cache
LOGS_DIR=logs
