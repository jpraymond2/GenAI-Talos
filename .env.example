# Copy to .env. Sample mode needs none of the keys below.
SAMPLE_MODE=true
DATA_BACKEND=duckdb
LLM_PROVIDER=anthropic

# Model names. Placeholders until you pick a model.
ANTHROPIC_MODEL=your-anthropic-model
OPENAI_MODEL=your-openai-model

# API keys. Leave blank when SAMPLE_MODE=true.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
ZETARIS_URL=
ZETARIS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RIVA_SERVER=
RIVA_API_KEY=

# Bounds. HTTP calls time out at 15s; the critic gets 2 rounds; retries stop at 3.
HTTP_TIMEOUT_SECONDS=15
MAX_CRITIC_ROUNDS=2
MAX_RETRIES=3

SAMPLE_DATA_DIR=data/sample
CACHE_DIR=data/cache
LOGS_DIR=logs
